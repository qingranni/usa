//
//  Secrets.swift.example  →  copy to Secrets.swift (gitignored)
//  Universal Search App
//
//  Template for the local OpenAI key. The real Secrets.swift is gitignored.
//  Leaving openAIKey empty runs the app on the deterministic mock responses.
//

enum Secrets {
    /// OpenAI API key. Empty string → mock-only mode.
    static let openAIKey = ""

    /// Chat model used for the live assistant.
    static let model = "gpt-4o-mini"
}
